{
  "cleanUrls": true,
  "installCommand": "echo \"Aucune dependance a installer : le site est statique.\"",
  "buildCommand": "echo \"Rien a construire : les pages sont deja fabriquees et commitees.\"",
  "outputDirectory": ".",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude,glob)**/*.md' ':(exclude,glob)scrapers/**' ':(exclude,glob)scripts/**' ':(exclude,glob).github/**'",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/commun/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cabinet",
      "destination": "/mpps#cabinet",
      "permanent": true
    }
  ]
}
